{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/index", "destination": "/admin/index.html" },
    { "source": "/admin/billing", "destination": "/admin/billing.html" },
    { "source": "/admin/products", "destination": "/admin/products.html" },
    { "source": "/admin/orders", "destination": "/admin/orders.html" },
    { "source": "/admin/invoices", "destination": "/admin/invoices.html" },
    { "source": "/admin/customers", "destination": "/admin/customers.html" },
    { "source": "/admin/reports", "destination": "/admin/reports.html" },
    { "source": "/admin/settings", "destination": "/admin/settings.html" },
    { "source": "/billing", "destination": "/admin/billing.html" },
    { "source": "/billing.html", "destination": "/admin/billing.html" },
    { "source": "/orders", "destination": "/admin/orders.html" },
    { "source": "/orders.html", "destination": "/admin/orders.html" },
    { "source": "/reports", "destination": "/admin/reports.html" },
    { "source": "/reports.html", "destination": "/admin/reports.html" },
    { "source": "/customers", "destination": "/admin/customers.html" },
    { "source": "/customers.html", "destination": "/admin/customers.html" },
    { "source": "/settings", "destination": "/admin/settings.html" },
    { "source": "/settings.html", "destination": "/admin/settings.html" },
    { "source": "/invoices", "destination": "/admin/invoices.html" },
    { "source": "/invoices.html", "destination": "/admin/invoices.html" },
    { "source": "/invoice", "destination": "/invoice.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/product-details", "destination": "/product-details.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/login", "destination": "/login.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
